nguages", "styles": ["bold"]}, {"type": "text", "content": " Common plus two other languages "}, {"type": "text", "content": "CR", "styles": ["bold"]}, {"type": "text", "content": " 1/8 (XP 25; PB +2)"}]}, {"type": "paragraph_title", "index": 9, "bbox": [0.103, 0.314, 0.171, 0.331], "content": [{"type": "text", "content": "Actions"}], "level": 2}, {"type": "text", "index": 10, "bbox": [0.102, 0.335, 0.465, 0.369], "content": [{"type": "text", "content": "Rapier.", "styles": ["bold"]}, {"type": "text", "content": " Melee Attack Roll: +3, reach 5 ft. Hit: 5 (1d8 + 1) Piercing damage."}]}, {"type": "paragraph_title", "index": 11, "bbox": [0.104, 0.375, 0.188, 0.391], "content": [{"type": "text", "content": "Reactions"}], "level": 2}, {"type": "text", "index": 12, "bbox": [0.101, 0.395, 0.482, 0.445], "content": [{"type": "text", "content": "Parry.", "styles": ["bold"]}, {"type": "text", "content": " Trigger: The noble is hit by a melee attack roll while holding a weapon. Response: The noble adds 2 to its AC against that attack, possibly causing it to miss."}]}, {"type": "paragraph_title", "index": 13, "bbox": [0.104, 0.451, 0.261, 0.475], "content": [{"type": "text", "content": "Ochre Jelly"}], "level": 2}, {"type": "paragraph_title", "index": 14, "bbox": [0.104, 0.48, 0.227, 0.502], "content": [{"type": "text", "content": "Ochre Jelly"}], "level": 2}, {"type": "text", "index": 15, "bbox": [0.103, 0.504, 0.258, 0.52], "content": [{"type": "text", "content": "Large Ooze, Unaligned"}]}, {"type": "text", "index": 16, "bbox": [0.103, 0.525, 0.382, 0.54], "content": [{"type": "text", "content": "AC", "styles": ["bold"]}, {"type": "text", "content": " 8 "}, {"type": "text", "content": "Initiative", "styles": ["bold"]}, {"type": "text", "content": " −2 (8)"}]}, {"type": "text", "index": 17, "bbox": [0.104, 0.541, 0.226, 0.555], "content": [{"type": "text", "content": "HP", "styles": ["bold"]}, {"type": "text", "content": " 52 (7d10 + 14)"}]}, {"type": "text", "index": 18, "bb