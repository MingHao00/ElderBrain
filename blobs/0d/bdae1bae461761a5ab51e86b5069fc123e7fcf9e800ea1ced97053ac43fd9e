202], "content": [{"type": "text", "content": "Fetid Cloud (1/Day).", "styles": ["bold"]}, {"type": "text", "content": " Constitution Saving Throw: DC 11, each creature in a 10-foot Emanation originating from the dretch. Failure: The target has the Poisoned condition until the end of its next turn. While Poisoned, the creature can take either an action or a Bonus Action on its turn, not both, and it can’t take Reactions."}]}, {"type": "paragraph_title", "index": 30, "bbox": [0.525, 0.209, 0.622, 0.231], "content": [{"type": "text", "content": "Drider"}], "level": 2}, {"type": "paragraph_title", "index": 31, "bbox": [0.525, 0.239, 0.602, 0.259], "content": [{"type": "text", "content": "Drider"}], "level": 2}, {"type": "text", "index": 32, "bbox": [0.524, 0.262, 0.729, 0.279], "content": [{"type": "text", "content": "Large Monstrosity, Chaotic Evil"}]}, {"type": "text", "index": 33, "bbox": [0.524, 0.283, 0.57, 0.298], "content": [{"type": "text", "content": "AC", "styles": ["bold"]}, {"type": "text", "content": " 19"}]}, {"type": "text", "index": 34, "bbox": [0.699, 0.284, 0.813, 0.298], "content": [{"type": "text", "content": "Initiative", "styles": ["bold"]}, {"type": "text", "content": " +4 (14)"}]}, {"type": "text", "index": 35, "bbox": [0.524, 0.299, 0.664, 0.314], "content": [{"type": "text", "content": "HP", "styles": ["bold"]}, {"type": "text", "content": " 123 (13d10 + 52)"}]}, {"type": "text", "index": 36, "bbox": [0.524, 0.314, 0.693, 0.33], "content": [{"type": "text", "content": "Speed", "styles": ["bold"]}, {"type": "text", "content": " 30 ft., Climb 30 ft."}]}, {"type": "table", "index": 37, "bbox": [0.525, 0.332, 0.91, 0.379], "content": [{"type": "table_body", "index": 37, "bbox": [0.525, 0.332, 0.91, 0.379], "content": "<table><tbody><tr><td>MOD SAVE</td><td>MOD SAVE</td><td>MOD SAVE</td></tr><tr><td>Str 16 +3 +3</td><td>Dex 19 +4 +4</td><td>Con18 +4 +4</td></tr><tr><td>Int 13 +1 +1</td><td>Wis 16 +3 +3</td><td>Cha 12 +1 +1</td></tr></tbody></table>