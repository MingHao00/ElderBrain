 0.584, 0.885, 0.631], "content": [{"type": "text", "content": "Holy Mace.", "styles": ["bold"]}, {"type": "text", "content": " Melee Attack Roll: +8, reach 5 ft. Hit: 7 (1d6 + 4) Bludgeoning damage plus 18 (4d8) Radiant damage."}]}, {"type": "text", "index": 39, "bbox": [0.522, 0.635, 0.91, 0.684], "content": [{"type": "text", "content": "Spellcasting.", "styles": ["bold"]}, {"type": "text", "content": " The deva casts one of the following spells, requiring no Material components and using Charisma as the spellcasting ability (spell save DC 17):"}]}, {"type": "text", "index": 40, "bbox": [0.522, 0.687, 0.91, 0.764], "content": [{"type": "text", "content": "At Will:", "styles": ["bold"]}, {"type": "text", "content": " Detect Evil and Good, Shapechange (Beast or Humanoid form only, no Temporary Hit Points gained from the spell, and no Concentration or Temporary Hit Points required to maintain the spell) "}, {"type": "text", "content": "1/Day Each:", "styles": ["bold"]}, {"type": "text", "content": " Commune, Raise Dead"}]}, {"type": "paragraph_title", "index": 41, "bbox": [0.524, 0.772, 0.65, 0.789], "content": [{"type": "text", "content": "Bonus Actions"}], "level": 2}, {"type": "text", "index": 42, "bbox": [0.522, 0.793, 0.887, 0.843], "content": [{"type": "text", "content": "Divine Aid (2/Day).", "styles": ["bold"]}, {"type": "text", "content": " The deva casts Cure Wounds, Lesser Restoration, or Remove Curse, using the same spellcasting ability as Spellcasting."}]}, {"type": "page_number", "index": 43, "bbox": [0.028, 0.952, 0.061, 0.967], "content": [{"type": "text", "content": "279"}]}, {"type": "footer", "index": 44, "bbox": [0.102, 0.951, 0.374, 0.969], "content": [{"type": "text", "content": "System Reference Document 5.2.1"}]}]}, {"page_idx": 279, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.104, 0.05, 0.19, 0.074], "content": [{"type": "text", "content": "Djinni"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.104, 0.08,