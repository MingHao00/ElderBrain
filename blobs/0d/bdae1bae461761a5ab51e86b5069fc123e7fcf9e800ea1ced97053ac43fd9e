ride.", "styles": ["bold"]}, {"type": "text", "content": " If within 5 feet of a Large or bigger tree, the dryad teleports to an unoccupied space within 5 feet of a second Large or bigger tree that is within 60 feet of the previous tree."}]}, {"type": "paragraph_title", "index": 36, "bbox": [0.525, 0.409, 0.753, 0.432], "content": [{"type": "text", "content": "Earth Elemental"}], "level": 2}, {"type": "paragraph_title", "index": 37, "bbox": [0.525, 0.44, 0.704, 0.459], "content": [{"type": "text", "content": "Earth Elemental"}], "level": 2}, {"type": "text", "index": 38, "bbox": [0.524, 0.462, 0.691, 0.479], "content": [{"type": "text", "content": "Large Elemental, Neutral"}]}, {"type": "text", "index": 39, "bbox": [0.525, 0.483, 0.57, 0.498], "content": [{"type": "text", "content": "AC", "styles": ["bold"]}, {"type": "text", "content": " 17"}]}, {"type": "text", "index": 40, "bbox": [0.699, 0.484, 0.804, 0.498], "content": [{"type": "text", "content": "Initiative", "styles": ["bold"]}, {"type": "text", "content": " −1 (9)"}]}, {"type": "text", "index": 41, "bbox": [0.525, 0.499, 0.664, 0.514], "content": [{"type": "text", "content": "HP", "styles": ["bold"]}, {"type": "text", "content": " 147 (14d10 + 70)"}]}, {"type": "text", "index": 42, "bbox": [0.525, 0.515, 0.702, 0.53], "content": [{"type": "text", "content": "Speed", "styles": ["bold"]}, {"type": "text", "content": " 30 ft., Burrow 30 ft."}]}, {"type": "table", "index": 43, "bbox": [0.525, 0.532, 0.91, 0.579], "content": [{"type": "table_body", "index": 43, "bbox": [0.525, 0.532, 0.91, 0.579], "content": "<table><tbody><tr><td>MOD SAVE</td><td>MOD SAVE</td><td>MOD SAVE</td></tr><tr><td>Str 20 +5 +5</td><td>Dex 8 -1 -1</td><td>Con20 +5 +5</td></tr><tr><td>Int 5 -3 -3</td><td>Wis 10 +0 +0</td><td>Cha 5 -3 -3</td></tr></tbody></table>"}]}, {"type": "text", "index": 44, "bbox": [0.524, 0.587, 0.687, 0.603], "content": [{"type": "text", "content": "Vulnerabilities", "styles": ["bold"]}, {"type": "text", "content"