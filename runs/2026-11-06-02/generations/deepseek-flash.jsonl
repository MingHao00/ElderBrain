{"question_id": "R09", "model_name": "deepseek-flash", "retry": false, "raw": "{\"type\":\"answer\",\"refusal_category\":null,\"sentences\":[{\"text\":\"被擒抱生物的速度变为 0，且无法从任何速度加值中获益。\",\"entry_id\":\"srd51:condition:grappled\"},{\"text\":\"被擒抱的生物可以用一个动作尝试挣脱，为此它必须成功通过一次力量（运动）或敏捷（杂技）检定，对抗擒抱者的力量（运动）检定。\",\"entry_id\":\"srd51:rule:combat\"},{\"text\":\"最终由 DM 裁定。\",\"entry_id\":\"srd51:rule:combat\"}]}", "usage": {"completion_tokens": 127, "prompt_tokens": 2419, "total_tokens": 2546, "prompt_cache_hit_tokens": 0, "prompt_cache_miss_tokens": 2419}, "yuan": 0.005854, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
