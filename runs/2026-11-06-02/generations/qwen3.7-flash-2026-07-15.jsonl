{"question_id": "L07", "model_name": "qwen3.7-flash-2026-07-15", "retry": false, "raw": "{\n  \"type\": \"answer\",\n  \"refusal_category\": null,\n  \"sentences\": [\n    {\n      \"text\": \"当你在 1 级选择生命领域时，你获得重甲熟练。\",\n      \"entry_id\": \"srd51:subclass:life-domain\"\n    },\n    {\n      \"text\": \"同样从 1 级开始，你的治疗法术效果更佳，每当你使用一个 1 环或更高环位的法术恢复某个生物的生命值时，该生物还会额外恢复 2 + 法术环阶 点生命值。\",\n      \"entry_id\": \"srd51:subclass:life-domain\"\n    }\n  ]\n}", "usage": {"completion_tokens": 157, "prompt_tokens": 5679, "total_tokens": 5836}, "yuan": 0.0012613999999999998, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
{"question_id": "L08", "model_name": "qwen3.7-flash-2026-07-15", "retry": false, "raw": "{\n  \"type\": \"answer\",\n  \"refusal_category\": null,\n  \"sentences\": [\n    {\n      \"text\": \"目盲生物无法看见，并且任何需要视觉的属性检定都会自动失败。\",\n      \"entry_id\": \"srd51:condition:blinded\"\n    },\n    {\n      \"text\": \"针对该生物的攻击检定具有优势，而该生物的攻击检定具有劣势。\",\n      \"entry_id\": \"srd51:condition:blinded\"\n    }\n  ]\n}", "usage": {"completion_tokens": 122, "prompt_tokens": 2081, "total_tokens": 2203}, "yuan": 0.0005138, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
{"question_id": "L10", "model_name": "qwen3.7-flash-2026-07-15", "retry": false, "raw": "{\n  \"type\": \"answer\",\n  \"refusal_category\": null,\n  \"sentences\": [\n    {\n      \"text\": \"成年红龙的挑战等级是17。\",\n      \"entry_id\": \"srd51:monster:adult-red-dragon\"\n    }\n  ]\n}", "usage": {"completion_tokens": 71, "prompt_tokens": 5360, "total_tokens": 5431}, "yuan": 0.0011288, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
{"question_id": "M01", "model_name": "qwen3.7-flash-2026-07-15", "retry": false, "raw": "{\n  \"type\": \"answer\",\n  \"refusal_category\": null,\n  \"sentences\": [\n    {\n      \"text\": \"当一个你能看见的敌对生物移动离开你的触及范围时，你可以对它进行一次借机攻击。\",\n      \"entry_id\": \"srd51:rule:combat\"\n    },\n    {\n      \"text\": \"若你在移动中离开了一个敌对生物的触及范围，就会引发借机攻击。\",\n      \"entry_id\": \"srd51:rule:combat\"\n    }\n  ]\n}", "usage": {"completion_tokens": 127, "prompt_tokens": 3103, "total_tokens": 3230}, "yuan": 0.0007222000000000001, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
{"question_id": "M03", "model_name": "qwen3.7-flash-2026-07-15", "retry": false, "raw": "{\n  \"type\": \"answer\",\n  \"refusal_category\": null,\n  \"sentences\": [\n    {\n      \"text\": \"拥有半掩护的目标，其 AC 获得 +2 加值。\",\n      \"entry_id\": \"srd51:rule:combat\"\n    },\n    {\n      \"text\": \"拥有四分之三掩护的目标，其 AC 获得 +5 加值。\",\n      \"entry_id\": \"srd51:rule:combat\"\n    }\n  ]\n}", "usage": {"completion_tokens": 120, "prompt_tokens": 3161, "total_tokens": 3281}, "yuan": 0.0007282, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
{"question_id": "M05", "model_name": "qwen3.7-flash-2026-07-15", "retry": false, "raw": "{\n  \"type\": \"answer\",\n  \"refusal_category\": null,\n  \"sentences\": [\n    {\n      \"text\": \"在短休结束时，角色可以花费生命骰来恢复生命值。\",\n      \"entry_id\": \"srd51:rule:adventuring\"\n    },\n    {\n      \"text\": \"若吟游诗人在短休期间使用休憩之歌特性，通过花费生命骰恢复生命值的生物会额外恢复一定点数的生命值（如d6、d8等）。\",\n      \"entry_id\": \"srd51:class:bard\"\n    },\n    {\n      \"text\": \"大地结社德鲁伊可以在短休期间恢复部分已消耗的法术位。\",\n      \"entry_id\": \"srd51:subclass:circle-of-the-land\"\n    },\n    {\n      \"text\": \"法师可以在短休时通过奥术恢复特性恢复部分已消耗的法术位。\",\n      \"entry_id\": \"srd51:class:wizard\"\n    }\n  ]\n}", "usage": {"completion_tokens": 238, "prompt_tokens": 8320, "total_tokens": 8558}, "yuan": 0.0018544000000000002, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
{"question_id": "M06", "model_name": "qwen3.7-flash-2026-07-15", "retry": false, "raw": "{\n  \"type\": \"answer\",\n  \"refusal_category\": null,\n  \"sentences\": [\n    {\n      \"text\": \"每当你在自己回合开始时生命值为0，都必须进行一次特殊豁免，称为死亡豁免。掷一个d20，若结果为10或更高，则成功；否则失败。\",\n      \"entry_id\": \"srd51:rule:combat\"\n    },\n    {\n      \"text\": \"当你累积第三次成功时，你会变为稳定状态。\",\n      \"entry_id\": \"srd51:rule:combat\"\n    }\n  ]\n}", "usage": {"completion_tokens": 136, "prompt_tokens": 4210, "total_tokens": 4346}, "yuan": 0.0009507999999999999, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
{"question_id": "M08", "model_name": "qwen3.7-flash-2026-07-15", "retry": false, "raw": "{\n  \"type\": \"answer\",\n  \"refusal_category\": null,\n  \"sentences\": [\n    {\n      \"text\": \"每回合一次，当你以一次攻击命中一个生物，且你的该次攻击检定具有优势时，可以对该生物额外造成偷袭伤害。\",\n      \"entry_id\": \"srd51:class:rogue\"\n    },\n    {\n      \"text\": \"该攻击必须使用灵巧武器或远程武器。\",\n      \"entry_id\": \"srd51:class:rogue\"\n    },\n    {\n      \"text\": \"如果目标 5 尺内有另一个它的敌人，且该敌人未失能，并且你此次攻击检定没有劣势，那么即使你没有优势，也可以造成偷袭伤害。\",\n      \"entry_id\": \"srd51:class:rogue\"\n    }\n  ]\n}", "usage": {"completion_tokens": 193, "prompt_tokens": 3129, "total_tokens": 3322}, "yuan": 0.0007802000000000001, "peak": true, "structure_ok": true, "citation_scope_ok": true, "numbers_ok": true, "version_ok": true, "category_ok": true, "false_refusal": false, "require_dm_ok": true, "require_clarify": false, "clarify_ok": true, "api_error": false}
