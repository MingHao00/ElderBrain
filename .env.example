# 会话结束 Hook 调用模型的密钥。只放本机环境变量或 .env，不要写入仓库。
SESSION_LOG_API_KEY=

# OpenAI 兼容接口根地址。留空时 Hook 使用 https://api.deepseek.com
SESSION_LOG_BASE_URL=

# 对话模型。留空时 Hook 使用 deepseek-chat
SESSION_LOG_MODEL=

# 嵌入接口。OpenAI 兼容，地址要带 /v1。密钥只放本机 .env。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 重排模型。密钥和主机沿用上面的嵌入配置。
RERANK_MODEL=

# 本轮对照嵌入：智谱 embedding-3。密钥与千问分开。地址不要带 /embeddings。
COMPARE_EMBEDDING_API_KEY=
COMPARE_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
COMPARE_EMBEDDING_MODEL=embedding-3

# 生成模型固定为 qwen3.7-flash-2026-07-15。密钥和地址缺省沿用上面的嵌入配置。
# 若要分开，填写下面两项。地址要带 /v1。密钥只放本机 .env。
QWEN_API_KEY=
QWEN_BASE_URL=

# 第一期告警邮件。凭据只放本机环境变量或 .env，不要写入仓库。
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_MAIL_FROM=
ALERT_MAIL_TO=

# 网页会话签名密钥。标准 base64，解码后必须是 32 字节。只放本机 .env。
JWT_SIGNING_KEY=

# 管理员名单。github:数字编号 或 email:已验证邮箱，逗号分隔。空表示没有管理员。
ADMIN_IDENTITIES=

# 注册 IP 哈希盐。不能写进代码。只放本机 .env。
LOGIN_IP_SALT=

# 邮箱验证码发信。缺任一项就拒绝发信。
LOGIN_SMTP_HOST=
LOGIN_SMTP_PORT=
LOGIN_SMTP_USER=
LOGIN_SMTP_PASSWORD=
LOGIN_MAIL_FROM=

# GitHub OAuth。缺任一项时只关闭这一条登录。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# 本机 PostgreSQL。口令只放 .env，不要写入仓库。
DATABASE_URL=
